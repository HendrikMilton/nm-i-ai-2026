{
  "name": "nm-ai-debug",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tailwindcss -i src/index.css -o src/compiled.css --watch & bun --hot src/index.ts & bun src/server.ts",
    "dev:api": "bun src/server.ts",
    "dev:css": "tailwindcss -i src/index.css -o src/compiled.css --watch",
    "build:css": "tailwindcss -i src/index.css -o src/compiled.css --minify",
    "build": "bun run build:css && bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify",
    "start": "NODE_ENV=production bun src/index.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "tailwindcss": "3"
  }
}
