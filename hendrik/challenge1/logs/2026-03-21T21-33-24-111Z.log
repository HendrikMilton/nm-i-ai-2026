[2026-03-21T21:34:13.760Z] [STEP 2] calls: calculate({"expression":"\n// January totals by account\nconst jan = [\n  {number: 5000, name: \"Lønn til ansatte\", amount: 150000},\n  {number: 6300, name: \"Leie lokale\", amount: 4000 + 12000},\n  {number: 6500, name: \"Motordrevet verktøy\", amount: 2400},\n  {number: 7100, name: \"Bilgodtgjørelse oppgavepliktig\", amount: 5000},\n  {number: 7300, name: \"Salgskostnad\", amount: 6400},\n  {number: 7400, name: \"Kontingent, fradragsberettiget\", amount: 4800}\n];\n\n// February totals by account\nconst feb = [\n  {number: 5000, name: \"Lønn til ansatte\", amount: 155000},\n  {number: 6300, name: \"Leie lokale\", amount: 4500 + 12000},\n  {number: 6500, name: \"Motordrevet verktøy\", amount: 8000},\n  {number: 7100, name: \"Bilgodtgjørelse oppgavepliktig\", amount: 12000},\n  {number: 7300, name: \"Salgskostnad\", amount: 9600},\n  {number: 7400, name: \"Kontingent, fradragsberettiget\", amount: 5200}\n];\n\n// Calculate increases\nconst increases = jan.map(j => {\n  const f = feb.find(x => x.number === j.number);\n  return {number: j.number, name: j.name, jan: j.amount, feb: f ? f.amount : 0, increase: (f ? f.amount : 0) - j.amount};\n});\n\n// Sort by increase descending\nincreases.sort((a, b) => b.increase - a.increase);\n\nJSON.stringify(increases.slice(0, 6))\n"})
