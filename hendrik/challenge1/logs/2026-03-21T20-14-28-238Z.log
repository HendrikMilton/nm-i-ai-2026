[2026-03-21T20:15:28.853Z] [STEP 2] calls: calculate({"expression":"\n// January totals by account\nconst jan = [\n  {number: 5000, name: \"Lønn til ansatte\", amount: 150000},\n  {number: 6300, name: \"Leie lokale\", amount: 4000},\n  {number: 6500, name: \"Motordrevet verktøy\", amount: 2400},\n  {number: 6300, name: \"Leie lokale\", amount: 12000},\n  {number: 7100, name: \"Bilgodtgjørelse oppgavepliktig\", amount: 5000},\n  {number: 7300, name: \"Salgskostnad\", amount: 6400},\n  {number: 7400, name: \"Kontingent, fradragsberettiget\", amount: 4800}\n];\n\nconst feb = [\n  {number: 5000, name: \"Lønn til ansatte\", amount: 155000},\n  {number: 6300, name: \"Leie lokale\", amount: 4500},\n  {number: 6500, name: \"Motordrevet verktøy\", amount: 8000},\n  {number: 6300, name: \"Leie lokale\", amount: 12000},\n  {number: 7100, name: \"Bilgodtgjørelse oppgavepliktig\", amount: 12000},\n  {number: 7300, name: \"Salgskostnad\", amount: 9600},\n  {number: 7400, name: \"Kontingent, fradragsberettiget\", amount: 5200}\n];\n\nconst agg = (arr) => {\n  const m = {};\n  arr.forEach(x => { m[x.number] = (m[x.number] || 0) + x.amount; });\n  return m;\n};\n\nconst janTotals = agg(jan);\nconst febTotals = agg(feb);\n\nconst accounts = [5000, 6300, 6500, 7100, 7300, 7400];\nconst diffs = accounts.map(a => ({\n  number: a,\n  name: jan.find(x => x.number === a).name,\n  jan: janTotals[a] || 0,\n  feb: febTotals[a] || 0,\n  increase: (febTotals[a] || 0) - (janTotals[a] || 0)\n}));\n\ndiffs.sort((a, b) => b.increase - a.increase);\nJSON.stringify(diffs.slice(0, 5))\n"})
